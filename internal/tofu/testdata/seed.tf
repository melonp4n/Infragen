# Generated by infrachart. Review before applying.
#
# Resource bodies carry only the parameters the chart models. Run
# `tofu validate` to see what each provider still requires.
#
# Resource names come from asset IDs, never display names: a name-derived
# address would make renaming an asset destroy and recreate it.
#
# Removing an account also removes its provider block, and OpenTofu cannot
# destroy a resource whose provider is gone. Empty the account of assets,
# apply, then remove the account.
#
# Ports in these rules are always the DESTINATION port — the port being
# connected to. On AWS, from_port and to_port are the low and high bounds of
# one range, not a source and a destination: from_port = 443, to_port = 443
# is the range 443-443. Source ports are never constrained, because they are
# ephemeral, and every firewall here is stateful — return traffic needs no
# rule of its own.

terraform {
  required_providers {
    aws          = { source = "hashicorp/aws" }
    azurerm      = { source = "hashicorp/azurerm" }
    digitalocean = { source = "digitalocean/digitalocean" }
  }
}

# Resolved SSH keys: per resource, then per account, then deployment-wide.
locals {
  asset_3_ssh_key = coalesce(var.acc_1_ssh_public_key, var.ssh_public_key, "")
  asset_7_ssh_key = coalesce(var.acc_3_ssh_public_key, var.ssh_public_key, "")
  asset_9_ssh_key = coalesce(var.acc_4_ssh_public_key, var.ssh_public_key, "")
}

# ---------------------------------------------------------------
# AWS Account 1 (AWS)
# ---------------------------------------------------------------

# Credentials come from the environment or your provider profile.
provider "aws" {
  alias  = "acc_1"
  region = var.acc_1_region
}

variable "acc_1_region" {
  description = "Region for AWS Account 1"
  type        = string
  default     = "eu-west-2"
}

data "aws_availability_zones" "acc_1" {
  provider = aws.acc_1
  state    = "available"
}

resource "aws_vpc" "acc_1" {
  provider   = aws.acc_1
  cidr_block = "10.0.0.0/16"
}

resource "aws_subnet" "acc_1" {
  provider          = aws.acc_1
  vpc_id            = aws_vpc.acc_1.id
  cidr_block        = "10.0.1.0/24"
  availability_zone = data.aws_availability_zones.acc_1.names[0]
}

resource "aws_subnet" "acc_1_b" {
  provider          = aws.acc_1
  vpc_id            = aws_vpc.acc_1.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = data.aws_availability_zones.acc_1.names[1]
}

resource "aws_internet_gateway" "acc_1" {
  provider = aws.acc_1
  vpc_id   = aws_vpc.acc_1.id
}

# AWS Account 1 → Edge CDN
resource "aws_cloudfront_distribution" "asset_1" {
  provider    = aws.acc_1
  tags        = { Name = "Edge CDN" }
  price_class = "PriceClass_100"
  enabled     = true
  default_cache_behavior {
    viewer_protocol_policy = "redirect-to-https"
    default_ttl            = 3600
    target_origin_id       = "asset-1-origin"
    allowed_methods        = ["GET", "HEAD"]
    cached_methods         = ["GET", "HEAD"]
  }
  origin {
    domain_name = var.asset_1_origin_domain
    origin_id   = "asset-1-origin"
  }
  restrictions {
    geo_restriction {
      restriction_type = "none"
    }
  }
  viewer_certificate {
    cloudfront_default_certificate = true
  }
}

# AWS Account 1 → Public ALB
resource "aws_lb" "asset_2" {
  provider                   = aws.acc_1
  tags                       = { Name = "Public ALB" }
  internal                   = false
  load_balancer_type         = "application"
  drop_invalid_header_fields = true
  enable_deletion_protection = false
  subnets                    = [aws_subnet.acc_1.id, aws_subnet.acc_1_b.id]
  security_groups            = [aws_security_group.asset_2.id]
}

# AWS Account 1 → Web tier EC2
resource "aws_instance" "asset_3" {
  provider                    = aws.acc_1
  tags                        = { Name = "Web tier EC2" }
  instance_type               = "t3.micro"
  ami                         = "ami-0c55b159cbfafe1f0"
  associate_public_ip_address = false
  monitoring                  = false
  subnet_id                   = aws_subnet.acc_1.id
  key_name                    = one(aws_key_pair.asset_3_key[*].key_name)
  vpc_security_group_ids      = [aws_security_group.asset_3.id]
  metadata_options {
    http_tokens = "required"
  }
  root_block_device {
    volume_size = 20
    encrypted   = true
  }
}

# Web tier EC2 requires this
resource "aws_key_pair" "asset_3_key" {
  count      = local.asset_3_ssh_key != "" ? 1 : 0
  provider   = aws.acc_1
  key_name   = "asset-3"
  public_key = local.asset_3_ssh_key
}

# AWS Account 1 → Orders DB
resource "aws_db_instance" "asset_4" {
  provider                    = aws.acc_1
  tags                        = { Name = "Orders DB" }
  engine                      = "postgres"
  engine_version              = "16.3"
  instance_class              = "db.t3.micro"
  allocated_storage           = 20
  username                    = "dbadmin"
  storage_encrypted           = true
  publicly_accessible         = false
  auto_minor_version_upgrade  = true
  multi_az                    = false
  skip_final_snapshot         = true
  deletion_protection         = false
  backup_retention_period     = 0
  manage_master_user_password = true
  db_subnet_group_name        = aws_db_subnet_group.asset_4_subnets.name
  vpc_security_group_ids      = [aws_security_group.asset_4.id]
}

# Orders DB requires this
resource "aws_db_subnet_group" "asset_4_subnets" {
  provider   = aws.acc_1
  name       = "asset-4"
  subnet_ids = [aws_subnet.acc_1.id, aws_subnet.acc_1_b.id]
}

resource "aws_security_group" "asset_2" {
  provider = aws.acc_1
  name     = "asset_2"
  vpc_id   = aws_vpc.acc_1.id
}

# from AWS Account 1 → Edge CDN — origin fetch
resource "aws_vpc_security_group_ingress_rule" "asset_2_ingress_tcp_443_443_0" {
  provider          = aws.acc_1
  security_group_id = aws_security_group.asset_2.id
  ip_protocol       = "tcp"
  from_port         = 443
  to_port           = 443
  prefix_list_id    = data.aws_ec2_managed_prefix_list.com_amazonaws_global_cloudfront_origin_facing.id
}

# to AWS Account 1 → Web tier EC2 — health check + traffic
resource "aws_vpc_security_group_egress_rule" "asset_2_egress_tcp_8080_8080_1" {
  provider                     = aws.acc_1
  security_group_id            = aws_security_group.asset_2.id
  ip_protocol                  = "tcp"
  from_port                    = 8080
  to_port                      = 8080
  referenced_security_group_id = aws_security_group.asset_3.id
}

resource "aws_security_group" "asset_3" {
  provider = aws.acc_1
  name     = "asset_3"
  vpc_id   = aws_vpc.acc_1.id
}

# from AWS Account 1 → Public ALB — health check + traffic
resource "aws_vpc_security_group_ingress_rule" "asset_3_ingress_tcp_8080_8080_0" {
  provider                     = aws.acc_1
  security_group_id            = aws_security_group.asset_3.id
  ip_protocol                  = "tcp"
  from_port                    = 8080
  to_port                      = 8080
  referenced_security_group_id = aws_security_group.asset_2.id
}

# to AWS Account 1 → Orders DB — app queries
resource "aws_vpc_security_group_egress_rule" "asset_3_egress_tcp_5432_5432_1" {
  provider                     = aws.acc_1
  security_group_id            = aws_security_group.asset_3.id
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
  referenced_security_group_id = aws_security_group.asset_4.id
}

# to Internet — OS + package updates
resource "aws_vpc_security_group_egress_rule" "asset_3_egress_tcp_443_443_2" {
  provider          = aws.acc_1
  security_group_id = aws_security_group.asset_3.id
  ip_protocol       = "tcp"
  from_port         = 443
  to_port           = 443
  cidr_ipv4         = "0.0.0.0/0"
}

# from Office jumphost (203.0.113.10/32) — admin SSH access
resource "aws_vpc_security_group_ingress_rule" "asset_3_ingress_tcp_22_22_3" {
  provider          = aws.acc_1
  security_group_id = aws_security_group.asset_3.id
  ip_protocol       = "tcp"
  from_port         = 22
  to_port           = 22
  cidr_ipv4         = "203.0.113.10/32"
}

resource "aws_security_group" "asset_4" {
  provider = aws.acc_1
  name     = "asset_4"
  vpc_id   = aws_vpc.acc_1.id
}

# from AWS Account 1 → Web tier EC2 — app queries
resource "aws_vpc_security_group_ingress_rule" "asset_4_ingress_tcp_5432_5432_0" {
  provider                     = aws.acc_1
  security_group_id            = aws_security_group.asset_4.id
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
  referenced_security_group_id = aws_security_group.asset_3.id
}

# ---------------------------------------------------------------
# AWS Account 2 (AWS)
# ---------------------------------------------------------------

# Credentials come from the environment or your provider profile.
provider "aws" {
  alias  = "acc_2"
  region = var.acc_2_region
}

variable "acc_2_region" {
  description = "Region for AWS Account 2"
  type        = string
  default     = "eu-west-2"
}

data "aws_availability_zones" "acc_2" {
  provider = aws.acc_2
  state    = "available"
}

resource "aws_vpc" "acc_2" {
  provider   = aws.acc_2
  cidr_block = "10.0.0.0/16"
}

resource "aws_subnet" "acc_2" {
  provider          = aws.acc_2
  vpc_id            = aws_vpc.acc_2.id
  cidr_block        = "10.0.1.0/24"
  availability_zone = data.aws_availability_zones.acc_2.names[0]
}

resource "aws_subnet" "acc_2_b" {
  provider          = aws.acc_2
  vpc_id            = aws_vpc.acc_2.id
  cidr_block        = "10.0.2.0/24"
  availability_zone = data.aws_availability_zones.acc_2.names[1]
}

resource "aws_internet_gateway" "acc_2" {
  provider = aws.acc_2
  vpc_id   = aws_vpc.acc_2.id
}

# AWS Account 2 → Image resize fn
resource "aws_lambda_function" "asset_5" {
  provider      = aws.acc_2
  tags          = { Name = "Image resize fn" }
  runtime       = "nodejs20.x"
  handler       = "index.handler"
  memory_size   = 128
  timeout       = 3
  function_name = "asset-5"
  filename      = var.asset_5_package
  role          = aws_iam_role.asset_5_role.arn
}

# Image resize fn requires this
resource "aws_iam_role" "asset_5_role" {
  provider = aws.acc_2
  name     = "asset-5-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "lambda.amazonaws.com" }
    }]
  })
}

# AWS Account 2 → Uploads bucket
resource "aws_s3_bucket" "asset_6" {
  provider      = aws.acc_2
  tags          = { Name = "Uploads bucket" }
  force_destroy = true
  bucket_prefix = "asset-6-"
}

# Uploads bucket requires this
resource "aws_s3_bucket_public_access_block" "asset_6_public_access" {
  provider                = aws.acc_2
  bucket                  = aws_s3_bucket.asset_6.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

# Uploads bucket requires this
resource "aws_s3_bucket_server_side_encryption_configuration" "asset_6_encryption" {
  provider = aws.acc_2
  bucket   = aws_s3_bucket.asset_6.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

# Uploads bucket requires this
resource "aws_s3_bucket_versioning" "asset_6_versioning" {
  provider = aws.acc_2
  bucket   = aws_s3_bucket.asset_6.id
  versioning_configuration {
    status = "Enabled"
  }
}

# ---------------------------------------------------------------
# DigitalOcean (DigitalOcean)
# ---------------------------------------------------------------

# Credentials come from the environment or your provider profile.
provider "digitalocean" {
  alias = "acc_3"
}

variable "acc_3_region" {
  description = "Region for DigitalOcean"
  type        = string
  default     = "nyc3"
}

resource "digitalocean_vpc" "acc_3" {
  name   = "acc-3"
  region = var.acc_3_region
}

# DigitalOcean → App droplet
resource "digitalocean_droplet" "asset_7" {
  provider   = digitalocean.acc_3
  name       = "asset-7"
  size       = "s-1vcpu-1gb"
  image      = "ubuntu-24-04-x64"
  region     = "lon1"
  monitoring = true
  backups    = false
  vpc_uuid   = digitalocean_vpc.acc_3.id
  ssh_keys   = digitalocean_ssh_key.asset_7_key[*].id
}

# App droplet requires this
resource "digitalocean_ssh_key" "asset_7_key" {
  count      = local.asset_7_ssh_key != "" ? 1 : 0
  provider   = digitalocean.acc_3
  name       = "asset-7"
  public_key = local.asset_7_ssh_key
}

# DigitalOcean → Managed PG
resource "digitalocean_database_cluster" "asset_8" {
  provider             = digitalocean.acc_3
  name                 = "asset-8"
  engine               = "pg"
  version              = "16"
  size                 = "db-s-1vcpu-1gb"
  node_count           = 1
  region               = "lon1"
  private_network_uuid = digitalocean_vpc.acc_3.id
}

resource "digitalocean_firewall" "asset_7" {
  name        = "asset-7"
  droplet_ids = [digitalocean_droplet.asset_7.id]

  # from Office jumphost (203.0.113.10/32) — admin SSH access
  inbound_rule {
    protocol         = "tcp"
    port_range       = "22"
    source_addresses = ["203.0.113.10/32"]
  }
}

# ---------------------------------------------------------------
# Azure (Azure)
# ---------------------------------------------------------------

# Credentials come from the environment or your provider profile.
provider "azurerm" {
  alias = "acc_4"
  features {
  }
}

variable "acc_4_region" {
  description = "Region for Azure"
  type        = string
  default     = "uksouth"
}

resource "azurerm_resource_group" "acc_4" {
  provider = azurerm.acc_4
  name     = "acc_4"
  location = var.acc_4_region
}

resource "azurerm_virtual_network" "acc_4" {
  provider            = azurerm.acc_4
  name                = "acc_4"
  address_space       = ["10.0.0.0/16"]
  location            = azurerm_resource_group.acc_4.location
  resource_group_name = azurerm_resource_group.acc_4.name
}

resource "azurerm_subnet" "acc_4" {
  provider             = azurerm.acc_4
  name                 = "acc_4"
  resource_group_name  = azurerm_resource_group.acc_4.name
  virtual_network_name = azurerm_virtual_network.acc_4.name
  address_prefixes     = ["10.0.1.0/24"]
}

# Azure → Batch worker
resource "azurerm_linux_virtual_machine" "asset_9" {
  provider                        = azurerm.acc_4
  tags                            = { Name = "Batch worker" }
  size                            = "Standard_B2s"
  disable_password_authentication = true
  name                            = "asset-9"
  resource_group_name             = azurerm_resource_group.acc_4.name
  location                        = azurerm_resource_group.acc_4.location
  admin_username                  = "azureuser"
  network_interface_ids           = [azurerm_network_interface.asset_9_nic.id]
  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "StandardSSD_LRS"
  }
  source_image_reference {
    publisher = "Canonical"
    offer     = "ubuntu-24_04-lts"
    sku       = "server"
    version   = "latest"
  }
  admin_ssh_key {
    username   = "azureuser"
    public_key = local.asset_9_ssh_key
  }
}

# Batch worker requires this
resource "azurerm_network_interface" "asset_9_nic" {
  provider            = azurerm.acc_4
  name                = "asset-9-nic"
  resource_group_name = azurerm_resource_group.acc_4.name
  location            = azurerm_resource_group.acc_4.location
  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.acc_4.id
    private_ip_address_allocation = "Dynamic"
  }
}

# Managed prefix lists, so a CDN can reach its origin without a CIDR.

data "aws_ec2_managed_prefix_list" "com_amazonaws_global_cloudfront_origin_facing" {
  name = "com.amazonaws.global.cloudfront.origin-facing"
}

# Values the chart cannot supply. Sensitive ones have no default, so
# `tofu plan` prompts for them rather than storing a secret here.

variable "ssh_public_key" {
  description = "SSH public key for every Ansible host. export TF_VAR_ssh_public_key=\"$(cat ~/.ssh/id_ed25519.pub)\""
  type        = string
  default     = ""
}

variable "acc_1_ssh_public_key" {
  description = "SSH public key for Ansible hosts in AWS Account 1, overriding the deployment key"
  type        = string
  default     = ""
}

variable "acc_3_ssh_public_key" {
  description = "SSH public key for Ansible hosts in DigitalOcean, overriding the deployment key"
  type        = string
  default     = ""
}

variable "acc_4_ssh_public_key" {
  description = "SSH public key for Ansible hosts in Azure, overriding the deployment key"
  type        = string
  default     = ""
}

variable "asset_1_origin_domain" {
  description = "Origin the distribution fetches from"
  type        = string
  default     = "origin.example.com"
}

variable "asset_5_package" {
  description = "Path to the deployment package zip"
  type        = string
  default     = "lambda.zip"
}

# Hardcoded addresses. Not managed here — their CIDRs appear in the rules above.
#   Office jumphost — 203.0.113.10/32

# Declared connections that produced no firewall rule:
#   Internet → AWS Account 1 → Edge CDN (TCP/443): a CDN is publicly reachable by construction
#   Internet → AWS Account 1 → Edge CDN (TCP/80): a CDN is publicly reachable by construction
#   AWS Account 2 → Image resize fn → AWS Account 2 → Uploads bucket (TCP/443): access is governed by IAM or a resource policy, not a firewall — the port is irrelevant
