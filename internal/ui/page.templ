package ui

import (
  "infrachart/internal/catalog"
  "infrachart/internal/model"
)

// Page is the full document. The chart it renders is the starting state; from
// then on the browser owns the graph and asks the server for fragments.
templ Page(s model.Session) {
  <!DOCTYPE html>
  <html lang="en">
    <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width, initial-scale=1"/>
      <title>infrachart</title>
      <link rel="stylesheet" href="/static/app.css"/>
      <style>
        @providerCSS()
      </style>
    </head>
    <body>
      <div id="app">
        @topbar()
        <div class="canvas-wrap" id="canvas-wrap">
          <div class="canvas" id="canvas">
            @Canvas(s)
          </div>
        </div>
        <!-- Filled by /api/render/drawer. The whole panel is server-rendered so
             that param forms come from the catalog, not from the browser. -->
        <aside class="drawer hidden" id="drawer"></aside>
      </div>
      @addAccountPanel()
      @addExtIPPanel()
      @typeMenus()
      @generateModal()
      <input type="file" id="import-file" accept="application/json,.json" hidden/>
      <script src="/static/app.js"></script>
    </body>
  </html>
}

templ topbar() {
  <div class="topbar">
    <div class="brand">
      <div class="brand-mark"></div>
      <div class="brand-text"><b>infra</b>chart</div>
    </div>
    <div class="toolbtn primary" id="btn-add-account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"></path></svg>
      Add account
    </div>
    <div class="toolbtn" id="btn-add-extip">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M7 9h6M7 13h4"></path></svg>
      Add IP address
    </div>
    <div class="toolbtn" id="btn-generate">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"></path><path d="M8 9h8M8 13h5"></path></svg>
      Generate config
    </div>
    <div class="toolbtn" id="btn-import">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12M7 10l5 5 5-5M4 20h16"></path></svg>
      Import
    </div>
    <div class="toolbtn" id="btn-export">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 17V5M7 10l5-5 5 5M4 20h16"></path></svg>
      Export
    </div>
    <div class="zoom-controls">
      <div class="toolbtn zoom-btn" id="btn-zoom-out" title="Zoom out (Ctrl + scroll)">−</div>
      <div class="zoom-level" id="zoom-level" title="Click to reset to 100%">100%</div>
      <div class="toolbtn zoom-btn" id="btn-zoom-in" title="Zoom in (Ctrl + scroll)">+</div>
    </div>
    <div class="spacer"></div>
    <div class="legend">
      <div class="legend-item"><span class="legend-line legend-internal"></span>internal</div>
      <div class="legend-item"><span class="legend-line legend-ingress"></span>internet ingress</div>
      <div class="legend-item"><span class="legend-line legend-egress"></span>internet egress only</div>
      <div class="legend-item"><span class="legend-line legend-extip"></span>hardcoded IP (not deployed)</div>
      <div class="legend-item">click a line or a node to edit</div>
    </div>
  </div>
}

// addAccountPanel and addExtIPPanel are rendered once, hidden, and toggled by
// the browser. They carry no per-session data, so there is nothing to fetch.
templ addAccountPanel() {
  <div class="add-account-panel hidden" id="add-account-panel">
    <label for="new-acc-name">Account name</label>
    <input type="text" id="new-acc-name" value="AWS Account 1"/>
    <label for="new-acc-provider">Provider</label>
    <select id="new-acc-provider">
      for _, p := range catalog.All() {
        <option value={ p.Key }>{ p.Label }</option>
      }
    </select>
    <div class="add-account-row">
      <div class="toolbtn" data-close-panel="add-account-panel">Cancel</div>
      <div class="toolbtn primary" id="confirm-add-acc">Add account</div>
    </div>
  </div>
}

templ addExtIPPanel() {
  <div class="add-extip-panel hidden" id="add-extip-panel">
    <label for="new-extip-label">Label</label>
    <input type="text" id="new-extip-label" value="Jumphost"/>
    <label for="new-extip-ip">IP address <code>(CIDR accepted, e.g. /32)</code></label>
    <input type="text" id="new-extip-ip" placeholder="203.0.113.10" value="203.0.113.10"/>
    <div class="add-account-row">
      <div class="toolbtn" data-close-panel="add-extip-panel">Cancel</div>
      <div class="toolbtn primary" id="confirm-add-extip">Add IP</div>
    </div>
  </div>
}

// typeMenus renders one asset picker per provider up front. They are small and
// static, so pre-rendering all of them beats an endpoint and keeps markup
// generation out of the browser entirely.
templ typeMenus() {
  for _, p := range catalog.All() {
    <div class="type-menu hidden" data-type-menu={ p.Key } data-provider={ p.Key }>
      for _, t := range p.Types {
        <div class="type-menu-item" data-code={ t.Code }>
          <span class="type-menu-code">{ t.Code }</span>
          <span>{ t.Name }</span>
        </div>
      }
    </div>
  }
}

// generateModal holds the generated configuration. Populated on demand.
templ generateModal() {
  <div class="modal-backdrop hidden" id="generate-modal">
    <div class="modal">
      <div class="modal-head">
        <div class="modal-head-title">main.tf</div>
        <div class="modal-head-actions">
          <div class="toolbtn" id="btn-copy-tf" title="Copy the whole configuration to the clipboard">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M5 15V5a2 2 0 0 1 2-2h8"></path>
            </svg>
            <span data-copy-label>Copy</span>
          </div>
          <div class="toolbtn" id="btn-validate" title="Run tofu init and validate on this configuration">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"></path></svg>
            Validate
          </div>
          <div class="modal-close" data-close-panel="generate-modal">✕</div>
        </div>
      </div>
      // Filled by /api/validate. Hidden until a run has something to report.
      <div class="validate-result hidden" id="validate-result"></div>
      <div class="modal-body"><pre id="generate-output"></pre></div>
    </div>
  </div>
}
